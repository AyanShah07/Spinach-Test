# =============================================================================
# Local Docker
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/martech
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/martech
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SaaS (Neon / Supabase + Upstash)
# =============================================================================
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db?sslmode=require
# DATABASE_URL_SYNC=postgresql://user:pass@host/db?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

# =============================================================================
# LLM — OpenRouter (primary) | groq | ollama | none
# =============================================================================
LLM_PROVIDER=openrouter
# LLM_PROVIDER=langchain   # resume-aligned LangChain path
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=MarTech Intelligence

# Optional legacy
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

SCORE_DECAY_LAMBDA=0.05
RATE_LIMIT_EVENTS_PER_MIN=600
DEBUG=true

RUN_EMBEDDED_WORKER=true

# Run `alembic upgrade head` before starting the API/worker.
AUTO_CREATE_TABLES=false
APP_ENV=development
# In production, set APP_ENV=production and a random API_KEY (32+ chars).
API_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LLM_CIRCUIT_BREAKER_COOLDOWN_SEC=60
WORKER_CLAIM_IDLE_MS=60000
OUTBOX_RETENTION_DAYS=7
